# --- Servidor ---
PORT=3000
# Padrão 127.0.0.1. Use 0.0.0.0 apenas atrás de proxy/container e com autenticação ligada.
HOST=127.0.0.1
# development (ou --dev) sobe o Vite embutido e deixa auth opcional; qualquer outro valor = produção.
NODE_ENV=production

# --- Autenticação (ligada por padrão fora do modo dev) ---
MCP_AUTH_ENABLED=true
# Chaves estáticas separadas por vírgula e/ou segredo HS256 com no mínimo 32 caracteres
MCP_API_KEYS=
MCP_JWT_SECRET=

# --- CORS (padrão: http://localhost:3000) ---
MCP_CORS_ORIGINS=http://localhost:3000
MCP_CORS_ALLOW_WILDCARD=false

# --- Escaneamento de diretórios do host (padrão: /workspace) ---
MCP_ALLOWED_WORKSPACE_ROOTS=/workspace

# --- Console SQL (somente leitura por padrão) ---
MCP_DB_CONSOLE_WRITE=false

# --- Tree-sitter ---
MCP_TS_CACHE_ENABLED=true
# DEBUG | INFO | WARN | ERROR | SILENT (logs JSON em stderr)
MCP_TS_LOG_LEVEL=INFO
MCP_TS_MAX_FILE_SIZE_MB=5

# --- Limites de memória do store (MB) ---
MCP_MAX_PROJECT_MB=200
MCP_MAX_TOTAL_MB=1024

# --- Parse em worker threads ---
# Nº de workers (0 desativa), tamanho mínimo do arquivo para usar worker, timeout por parse
MCP_TS_WORKERS=2
MCP_TS_WORKER_MIN_CHARS=20000
MCP_TS_WORKER_TIMEOUT_MS=30000

# --- Banco SQLite (padrão: ./data/workspace.db) ---
# MCP_DB_PATH=./data/workspace.db
